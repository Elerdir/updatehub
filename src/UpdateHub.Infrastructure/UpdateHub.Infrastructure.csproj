<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UpdateHub.Infrastructure</RootNamespace>
    <!-- MailKit vuln is about parsing received mail; we only send — not affected -->
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UpdateHub.Application\UpdateHub.Application.csproj" />
    <ProjectReference Include="..\UpdateHub.Domain\UpdateHub.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.13" />
    <!-- Pin transitive dep to a patched version (NU1903: GHSA-w3x6-4m5h-cxqf / GHSA-37gx-xxp4-5rgx) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- Transitively via MailKit/MimeKit (10.0.0 has GHSA-846f-f764-76mx); pinned to the patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
