@page "/security"
@attribute [Authorize]
@rendermode InteractiveServer
@inject BruteForceProtectionService BruteForceSvc
@inject UpdateHub.Web.Localization.Translator L
@using UpdateHub.Domain.Entities

<PageTitle>@L["page.security"] — UpdateHub</PageTitle>

<div class="page-header">
    <h1>@L["page.security"]</h1>
</div>

@if (attempts is not null)
{
    <div class="stats" style="margin-bottom:24px;">
        <div class="stat-card">
            <span class="stat-value">@attempts.Count(a => a.IsBlocked)</span>
            <span class="stat-label">@L["security.blockedIps"]</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">@attempts.Count(a => !a.IsBlocked && a.FailedAttempts > 0)</span>
            <span class="stat-label">@L["security.suspiciousIps"]</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">@BruteForceProtectionService.MaxFailedAttempts</span>
            <span class="stat-label">@L["security.threshold"]</span>
        </div>
    </div>

    <div class="section-header">
        <h2>@L["security.loginAttempts"]</h2>
        <div style="display:flex;gap:8px;align-items:center;">
            <input @bind="filterIp" @bind:event="oninput"
                   placeholder="@L["security.filterIp"]" style="width:200px;padding:6px 10px;" />
            <button class="btn-ghost btn-sm" @onclick="Reload">@L["common.refresh"]</button>
        </div>
    </div>

    <AuthorizeView Roles="Admin">
        @if (!string.IsNullOrWhiteSpace(manualBlockIp))
        {
            <div class="card" style="margin-bottom:16px;">
                <div style="display:flex;align-items:center;gap:12px;">
                    <input @bind="manualBlockIp" placeholder="@L["security.col.ip"]" style="width:200px;padding:6px 10px;" />
                    <button class="btn-danger btn-sm" @onclick="ManualBlock">@L["security.blockThis"]</button>
                    <button class="btn-ghost btn-sm" @onclick="() => manualBlockIp = null">@L["common.cancel"]</button>
                </div>
            </div>
        }
        else
        {
            <div style="margin-bottom:16px;">
                <button class="btn-danger-outline btn-sm" @onclick="() => manualBlockIp = string.Empty">@L["security.blockManual"]</button>
            </div>
        }
    </AuthorizeView>

    @if (!Filtered.Any())
    {
        <div class="empty-state"><p>@L["security.empty"]</p></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@L["security.col.ip"]</th>
                    <th>@L["security.col.status"]</th>
                    <th>@L["security.col.failed"]</th>
                    <th>@L["security.col.firstSeen"]</th>
                    <th>@L["security.col.lastAttempt"]</th>
                    <th>@L["security.col.unblockedAt"]</th>
                    <th>@L["security.col.userAgent"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Filtered)
                {
                    <tr>
                        <td><code>@a.IpAddress</code></td>
                        <td>@StatusBadge(a)</td>
                        <td>@a.FailedAttempts</td>
                        <td title="@a.FirstAttemptAt.ToString("o")">@FormatDate(a.FirstAttemptAt)</td>
                        <td title="@a.LastAttemptAt.ToString("o")">@FormatDate(a.LastAttemptAt)</td>
                        <td>@(a.UnblockedAt.HasValue ? FormatDate(a.UnblockedAt.Value) : "—")</td>
                        <td><span class="ua-cell" title="@a.LastUserAgent">@TruncateUa(a.LastUserAgent)</span></td>
                        <td>
                            <AuthorizeView Roles="Admin">
                                <div style="display:flex;gap:6px;">
                                    @if (a.IsBlocked)
                                    {
                                        <button class="btn-sm btn-outline" @onclick="() => Unblock(a.IpAddress)">@L["security.unblock"]</button>
                                    }
                                    else
                                    {
                                        <button class="btn-danger-sm" @onclick="() => Block(a.IpAddress)">@L["security.block"]</button>
                                    }
                                    <button class="btn-ghost btn-sm" @onclick="() => DeleteRecord(a.IpAddress)"
                                            title="@L["security.removeRecord"]">✕</button>
                                </div>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <p class="loading">@L["common.loading"]</p>
}

@code {
    private List<LoginAttempt>? attempts;
    private string? filterIp;
    private string? manualBlockIp;

    private List<LoginAttempt> Filtered =>
        attempts is null ? [] :
        string.IsNullOrWhiteSpace(filterIp)
            ? attempts
            : attempts.Where(a => a.IpAddress.Contains(filterIp.Trim())).ToList();

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        attempts = await BruteForceSvc.GetAllAsync();
    }

    private async Task Unblock(string ip)
    {
        await BruteForceSvc.UnblockAsync(ip);
        await Reload();
    }

    private async Task Block(string ip)
    {
        await BruteForceSvc.BlockManuallyAsync(ip);
        await Reload();
    }

    private async Task ManualBlock()
    {
        if (string.IsNullOrWhiteSpace(manualBlockIp)) return;
        await BruteForceSvc.BlockManuallyAsync(manualBlockIp.Trim());
        manualBlockIp = null;
        await Reload();
    }

    private async Task DeleteRecord(string ip)
    {
        await BruteForceSvc.DeleteRecordAsync(ip);
        await Reload();
    }

    private RenderFragment StatusBadge(LoginAttempt a) => __builder =>
    {
        if (a.IsBlocked)
        {
            var label = a.IsManualBlock ? L["security.status.blocked.manual"] : L["security.status.blocked.auto"];
            __builder.AddMarkupContent(0, $"<span class=\"badge danger\">{label}</span>");
        }
        else if (a.FailedAttempts > 0)
        {
            var label = $"{L["security.status.suspicious"]} ({a.FailedAttempts}×)";
            __builder.AddMarkupContent(0, $"<span class=\"badge warning\">{label}</span>");
        }
        else
        {
            __builder.AddMarkupContent(0, $"<span class=\"badge published\">{L["security.status.ok"]}</span>");
        }
    };

    private static string FormatDate(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        return diff.TotalDays < 1
            ? $"{(int)diff.TotalHours}h ago"
            : dt.ToString("yyyy-MM-dd HH:mm");
    }

    private static string TruncateUa(string? ua) =>
        ua is null ? "—" :
        ua.Length > 50 ? ua[..47] + "…" : ua;
}
