@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject SettingsService SettingsSvc
@inject EmailNotificationService EmailSvc
@inject IConfiguration Config
@inject IJSRuntime JS
@inject UpdateHub.Web.Localization.Translator L
@using UpdateHub.Application.Models

<PageTitle>@L["page.settings"] — UpdateHub</PageTitle>

<div class="page-header">
    <h1>@L["page.settings"]</h1>
</div>

@* ── CI Token ────────────────────────────────────────────────────────────── *@
<div class="card" style="margin-bottom:24px;">
    <h3>@L["settings.ciToken"]</h3>
    <p style="color:var(--muted);margin-bottom:16px;font-size:13px;">
        @L["settings.ciToken.hint"]
    </p>

    @if (_token is not null)
    {
        <div class="token-display">
            <div class="token-box">@_token</div>
            <button class="btn-ghost btn-sm" @onclick="CopyToken">@L["common.copy"]</button>
        </div>
        @if (_copied) { <div class="info" style="margin-top:8px;">@L["common.copied"]</div> }
    }
    else
    {
        <div class="token-display">
            <div class="token-box" style="color:var(--muted);">@_masked</div>
            <button class="btn-ghost btn-sm" @onclick="RevealToken">@L["settings.reveal"]</button>
        </div>
    }

    <div style="margin-top:16px;">
        @if (_confirmRotate)
        {
            <span style="color:var(--muted);font-size:13px;margin-right:12px;">@L["settings.rotateConfirm"]</span>
            <button class="btn-danger" @onclick="DoRotate">@L["settings.rotateYes"]</button>
            <button class="btn-ghost btn-sm" style="margin-left:8px;" @onclick="() => _confirmRotate = false">@L["common.cancel"]</button>
        }
        else
        {
            <button class="btn-danger-outline btn-sm" @onclick="() => _confirmRotate = true">@L["settings.rotate"]…</button>
        }
    </div>
    @if (_rotateMsg is not null) { <div class="info" style="margin-top:8px;">@_rotateMsg</div> }
</div>

@* ── SMTP — editable runtime config ──────────────────────────────────────── *@
<div class="card">
    <h3>@L["settings.smtp"]</h3>
    <p style="color:var(--muted);font-size:13px;margin-bottom:16px;">
        @L["settings.smtp.hint"]
        @if (_envFallback) { <em>@L["settings.smtp.envHint"]</em> }
    </p>

    <div class="form-row">
        <div class="field">
            <label>@L["settings.smtp.host"]</label>
            <input @bind="_form.Host" placeholder="smtp.example.com" />
        </div>
        <div class="field">
            <label>@L["settings.smtp.port"]</label>
            <input type="number" @bind="_form.Port" />
        </div>
    </div>
    <div class="field">
        <label>@L["settings.smtp.from"]</label>
        <input @bind="_form.From" placeholder="updatehub@example.com" />
    </div>
    <div class="form-row">
        <div class="field">
            <label>@L["settings.smtp.username"]</label>
            <input @bind="_form.Username" autocomplete="off" />
        </div>
        <div class="field">
            <label>
                @L["settings.smtp.password"]
                @if (_hasStoredPassword)
                {
                    <span class="hint">(@L["settings.smtp.password.stored"])</span>
                }
            </label>
            <input type="password" @bind="_form.Password" autocomplete="new-password"
                   placeholder="@(_hasStoredPassword ? L["settings.smtp.password.placeholder"] : "")" />
        </div>
    </div>
    <div class="field">
        <label>@L["settings.smtp.to"]</label>
        <input @bind="_form.To" placeholder="alerts@example.com" />
    </div>

    @if (_clearPasswordToggled)
    {
        <div class="info" style="margin-bottom:12px;">@L["settings.smtp.password.willClear"]</div>
    }

    @if (_smtpMsg is not null) { <div class="info" style="margin-bottom:12px;">@_smtpMsg</div> }
    @if (_smtpErr is not null) { <div class="error" style="margin-bottom:12px;">@_smtpErr</div> }

    <div class="form-actions">
        <button class="btn-primary" @onclick="SaveSmtp">@L["common.save"]</button>
        <button class="btn-ghost"   @onclick="SendTestEmail" disabled="@_testInFlight">
            @(_testInFlight ? L["settings.smtp.sending"] : L["settings.smtp.sendTest"])
        </button>
        @if (_hasStoredPassword && !_clearPasswordToggled)
        {
            <button class="btn-ghost btn-sm" style="margin-left:auto;color:var(--danger);"
                    @onclick="() => _clearPasswordToggled = true">@L["settings.smtp.password.clear"]</button>
        }
        else if (_clearPasswordToggled)
        {
            <button class="btn-ghost btn-sm" style="margin-left:auto;"
                    @onclick="() => _clearPasswordToggled = false">@L["common.cancel"]</button>
        }
    </div>
</div>

@code {
    private string? _token;
    private string  _masked = "••••••••••••••••••••••••••••••••";
    private bool    _confirmRotate;
    private bool    _copied;
    private string? _rotateMsg;

    private SmtpFormModel _form = new();
    private bool          _hasStoredPassword;
    private bool          _envFallback;
    private bool          _clearPasswordToggled;
    private string?       _smtpMsg;
    private string?       _smtpErr;
    private bool          _testInFlight;

    protected override async Task OnInitializedAsync()
    {
        var cfg = await SettingsSvc.GetSmtpConfigAsync();
        _form = new SmtpFormModel
        {
            Host     = cfg.Host,
            Port     = cfg.Port,
            From     = cfg.From,
            Username = cfg.Username,
            Password = null, // never pre-fill — we only know the hash
            To       = cfg.To,
        };
        _hasStoredPassword = await SettingsSvc.HasStoredSmtpPasswordAsync();
        _envFallback = string.IsNullOrEmpty(cfg.Host) &&
                       !string.IsNullOrEmpty(Config["UpdateHub:Smtp:Host"]);
    }

    private async Task SaveSmtp()
    {
        _smtpMsg = _smtpErr = null;
        try
        {
            // Three cases for the password slot:
            //   typed something  → replace with new value
            //   blank + clear toggle on → clear the stored password
            //   blank + clear toggle off → keep whatever is stored
            string? newPw      = _form.Password;
            bool   replacePw   = !string.IsNullOrEmpty(newPw) || _clearPasswordToggled;
            if (_clearPasswordToggled) newPw = "";

            var cfg = new SmtpConfig(
                Host:     string.IsNullOrWhiteSpace(_form.Host) ? null : _form.Host.Trim(),
                Port:     _form.Port,
                From:     string.IsNullOrWhiteSpace(_form.From) ? null : _form.From.Trim(),
                Username: string.IsNullOrWhiteSpace(_form.Username) ? null : _form.Username.Trim(),
                Password: newPw,
                To:       string.IsNullOrWhiteSpace(_form.To) ? null : _form.To.Trim());
            await SettingsSvc.SaveSmtpConfigAsync(cfg, replacePassword: replacePw);
            _hasStoredPassword = await SettingsSvc.HasStoredSmtpPasswordAsync();
            _clearPasswordToggled = false;
            _form.Password = null;
            _envFallback   = false;
            _smtpMsg       = L["settings.smtp.saved"];
        }
        catch (Exception ex) { _smtpErr = ex.Message; }
    }

    private async Task SendTestEmail()
    {
        _smtpMsg = _smtpErr = null;
        _testInFlight = true;
        try
        {
            await EmailSvc.SendTestAsync();
            _smtpMsg = L["settings.smtp.testSent"];
        }
        catch (Exception ex) { _smtpErr = ex.Message; }
        finally { _testInFlight = false; }
    }

    private async Task RevealToken()
    {
        var dbToken = await SettingsSvc.GetCiTokenAsync();
        _token = string.IsNullOrWhiteSpace(dbToken)
            ? (Config["UpdateHub:CiToken"] ?? "(not configured)")
            : dbToken;
    }

    private async Task CopyToken()
    {
        if (_token is not null)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _token);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task DoRotate()
    {
        _confirmRotate = false;
        _token = await SettingsSvc.RotateCiTokenAsync();
        _rotateMsg = L["settings.rotatedMsg"];
    }

    private class SmtpFormModel
    {
        public string? Host { get; set; }
        public int     Port { get; set; } = 587;
        public string? From { get; set; }
        public string? Username { get; set; }
        public string? Password { get; set; }
        public string? To { get; set; }
    }
}
