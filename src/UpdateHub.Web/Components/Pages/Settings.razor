@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject SettingsService SettingsSvc
@inject EmailNotificationService EmailSvc
@inject IConfiguration Config
@inject IJSRuntime JS
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["page.settings"] — UpdateHub</PageTitle>

<div class="page-header">
    <h1>@L["page.settings"]</h1>
</div>

@* ── CI Token ────────────────────────────────────────────────────────────── *@
<div class="card" style="margin-bottom:24px;">
    <h3>CI Upload Token</h3>
    <p style="color:var(--muted);margin-bottom:16px;font-size:13px;">
        Used in GitHub Actions as <code>X-UpdateHub-Token</code> header.
        Rotating generates a new token — update your CI secrets afterwards.
    </p>

    @if (_token is not null)
    {
        <div class="token-display">
            <div class="token-box">@_token</div>
            <button class="btn-ghost btn-sm" @onclick="CopyToken">@L["common.copy"]</button>
        </div>
        @if (_copied) { <div class="info" style="margin-top:8px;">@L["common.copied"]</div> }
    }
    else
    {
        <div class="token-display">
            <div class="token-box" style="color:var(--muted);">@_masked</div>
            <button class="btn-ghost btn-sm" @onclick="RevealToken">Reveal</button>
        </div>
    }

    <div style="margin-top:16px;">
        @if (_confirmRotate)
        {
            <span style="color:var(--muted);font-size:13px;margin-right:12px;">Rotate and invalidate current token?</span>
            <button class="btn-danger" @onclick="DoRotate">Yes, rotate</button>
            <button class="btn-ghost btn-sm" style="margin-left:8px;" @onclick="() => _confirmRotate = false">@L["common.cancel"]</button>
        }
        else
        {
            <button class="btn-danger-outline btn-sm" @onclick="() => _confirmRotate = true">Rotate token…</button>
        }
    </div>
    @if (_rotateMsg is not null) { <div class="info" style="margin-top:8px;">@_rotateMsg</div> }
</div>

@* ── SMTP Notifications ──────────────────────────────────────────────────── *@
<div class="card">
    <h3>Email Notifications</h3>
    <p style="color:var(--muted);font-size:13px;">
        Configure <code>UpdateHub:Smtp:*</code> keys in <code>appsettings.json</code> (or environment variables)
        to enable email alerts for publish events, IP blocks, and password changes.
    </p>
    <table style="font-size:13px;border-collapse:collapse;width:100%;">
        <tr><td style="padding:4px 12px 4px 0;color:var(--muted);">Host</td><td><code>@(Config["UpdateHub:Smtp:Host"] ?? "(not set)")</code></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:var(--muted);">From</td><td><code>@(Config["UpdateHub:Smtp:From"] ?? "(not set)")</code></td></tr>
        <tr><td style="padding:4px 12px 4px 0;color:var(--muted);">To</td><td><code>@(Config["UpdateHub:Smtp:To"] ?? "(not set)")</code></td></tr>
    </table>
    <button class="btn-ghost btn-sm" style="margin-top:16px;" @onclick="SendTestEmail">Send test email</button>
    @if (_emailMsg is not null) { <div class="info" style="margin-top:8px;">@_emailMsg</div> }
</div>

@code {
    private string? _token;
    private string  _masked = "••••••••••••••••••••••••••••••••";
    private bool    _confirmRotate;
    private bool    _copied;
    private string? _rotateMsg;
    private string? _emailMsg;

    private async Task RevealToken()
    {
        var dbToken = await SettingsSvc.GetCiTokenAsync();
        _token = string.IsNullOrWhiteSpace(dbToken)
            ? (Config["UpdateHub:CiToken"] ?? "(not configured)")
            : dbToken;
    }

    private async Task CopyToken()
    {
        if (_token is not null)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _token);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }

    private async Task DoRotate()
    {
        _confirmRotate = false;
        _token = await SettingsSvc.RotateCiTokenAsync();
        _rotateMsg = "Token rotated — update your CI secrets with the new value above.";
    }

    private async Task SendTestEmail()
    {
        _emailMsg = null;
        await EmailSvc.SendReleasePublishedAsync("test-app", "1.0.0-test", "stable");
        _emailMsg = "Test email sent (if SMTP is configured, check your inbox).";
    }
}
