@page "/account/change-password"
@attribute [Authorize]
@layout UpdateHub.Web.Components.Layout.EmptyLayout
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["changepw.title"] — UpdateHub</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-brand">UpdateHub</div>
        <h2 style="font-size:16px;font-weight:600;margin-bottom:8px;text-align:center;">@L["changepw.title"]</h2>
        <p style="text-align:center;color:var(--muted);margin-bottom:20px;font-size:13px;">
            @L["changepw.prompt"]
        </p>
        <form method="post" action="/account/password/change">
            <AntiforgeryToken />
            @if (ErrorCode == "missing")  { <div class="error">@L["changepw.error.missing"]</div> }
            else if (ErrorCode == "mismatch") { <div class="error">@L["changepw.error.mismatch"]</div> }
            else if (ErrorCode == "invalid")  { <div class="error">@L["changepw.error.invalid"]</div> }

            <div class="field">
                <label for="current">@L["changepw.current"]</label>
                <input id="current" type="password" name="current" autocomplete="current-password" required autofocus />
            </div>
            <div class="field">
                <label for="new">@L["changepw.new"]</label>
                <input id="new" type="password" name="new" autocomplete="new-password" required minlength="8" />
            </div>
            <div class="field">
                <label for="confirm">@L["changepw.confirm"]</label>
                <input id="confirm" type="password" name="confirm" autocomplete="new-password" required minlength="8" />
            </div>
            <button type="submit" class="btn-primary btn-block">@L["changepw.submit"]</button>
        </form>
        <div style="margin-top:16px;text-align:center;">
            <form method="post" action="/account/logout" style="display:inline;">
                <AntiforgeryToken />
                <button type="submit" style="background:none;border:none;font-size:13px;color:var(--muted);cursor:pointer;">@L["nav.logout"]</button>
            </form>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }
}
