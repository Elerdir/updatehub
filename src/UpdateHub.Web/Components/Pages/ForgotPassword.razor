@page "/account/forgot"
@attribute [AllowAnonymous]
@layout UpdateHub.Web.Components.Layout.EmptyLayout
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["forgot.title"] — UpdateHub</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-brand">UpdateHub</div>
        <h2 style="font-size:16px;font-weight:600;margin-bottom:8px;text-align:center;">@L["forgot.title"]</h2>

        @if (Sent)
        {
            <p style="text-align:center;color:var(--muted);margin-bottom:20px;font-size:13px;">
                @L["forgot.sent"]
            </p>
            <a href="/login" class="btn-primary btn-block" style="text-align:center;text-decoration:none;display:block;">
                @L["forgot.backToLogin"]
            </a>
        }
        else
        {
            <p style="text-align:center;color:var(--muted);margin-bottom:20px;font-size:13px;">
                @L["forgot.prompt"]
            </p>
            <form method="post" action="/account/forgot">
                <AntiforgeryToken />
                <div class="field">
                    <label for="who">@L["forgot.who"]</label>
                    <input id="who" type="text" name="who" autocomplete="username" required autofocus />
                </div>
                <button type="submit" class="btn-primary btn-block">@L["forgot.submit"]</button>
            </form>
            <div style="margin-top:16px;text-align:center;">
                <a href="/login" style="font-size:13px;color:var(--muted);">← @L["forgot.backToLogin"]</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sent")]
    private string? SentParam { get; set; }
    private bool Sent => SentParam == "1";
}
