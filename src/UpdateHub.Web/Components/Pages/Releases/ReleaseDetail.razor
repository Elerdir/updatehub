@page "/releases/{ReleaseId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AdminService AdminSvc
@inject NavigationManager Nav
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["releases.version"] @(release?.Version ?? "") — UpdateHub</PageTitle>

@if (release is null)
{
    <p class="loading">@L["common.loading"]</p>
}
else
{
    <div class="breadcrumb">
        <a href="/apps">@L["page.apps"]</a> /
        <a href="/apps/@release.App.Slug">@release.App.Name</a> /
        @release.Version
    </div>

    <div class="page-header">
        <div class="page-header-left">
            <h1>@release.Version</h1>
            <span class="badge @release.Status.ToString().ToLower()">@L[$"releases.status.{release.Status.ToString().ToLower()}"]</span>
            <span class="badge channel-@release.Channel.ToString().ToLower()">@L[$"releases.channel.{release.Channel.ToString().ToLower()}"]</span>
            @if (release.IsMandatory) { <span class="badge mandatory">@L["releases.mandatoryBadge"]</span> }
        </div>
        <div class="header-actions">
            <AuthorizeView Roles="Admin,Manager">
                @if (release.Status == ReleaseStatus.Draft)
                {
                    <button class="btn-primary" @onclick="Publish">@L["common.publish"]</button>
                }
                @if (release.Status == ReleaseStatus.Published)
                {
                    <button class="btn-danger-outline" @onclick="Archive">@L["common.archive"]</button>
                }
                <button class="btn-ghost btn-sm" @onclick="ConfirmDelete">@L["common.delete"]</button>
            </AuthorizeView>
        </div>
    </div>

    <AuthorizeView Roles="Admin,Manager">
    <div class="card" style="margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
            <div>
                <strong>@L["releases.minFromVersion"]</strong>
                <span style="margin-left:8px;font-size:13px;color:var(--muted);">@L["releases.minFromVersion.hint"]</span>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
                @if (editingMinFrom)
                {
                    <input @bind="minFromInput" placeholder="e.g. 1.4.0" style="width:140px;padding:6px 10px;" />
                    <button class="btn-primary btn-sm" @onclick="SaveMinFrom">@L["common.save"]</button>
                    <button class="btn-ghost btn-sm" @onclick="() => editingMinFrom = false">@L["common.cancel"]</button>
                }
                else
                {
                    <code style="font-size:12px;padding:4px 8px;background:var(--surface2);border-radius:4px;">
                        @(string.IsNullOrEmpty(release.MinFromVersion) ? L["releases.minFromVersion.none"] : release.MinFromVersion)
                    </code>
                    <button class="btn-ghost btn-sm" @onclick="StartEditMinFrom">@L["common.edit"]</button>
                }
            </div>
        </div>
    </div>
    </AuthorizeView>

    @if (!string.IsNullOrWhiteSpace(release.ReleaseNotes))
    {
        <div class="release-notes card">
            <div class="release-notes-title">@L["releases.notes"]</div>
            <MarkdownView Content="@release.ReleaseNotes" />
        </div>
    }

    <div class="section-header">
        <h2>@L["releases.artifacts"]</h2>
    </div>

    <AuthorizeView Roles="Admin,Manager">
    <div class="card upload-form">
        <h3>@L["releases.upload"]</h3>
        <div class="form-row">
            <div class="field">
                <label>@L["releases.col.platform"]</label>
                <select @bind="uploadPlatform">
                    <option value="windows">Windows</option>
                    <option value="macos">macOS</option>
                    <option value="linux">Linux</option>
                </select>
            </div>
            <div class="field">
                <label>@L["releases.col.arch"]</label>
                <select @bind="uploadArch">
                    <option value="x64">x64</option>
                    <option value="arm64">arm64</option>
                    <option value="x86">x86</option>
                </select>
            </div>
        </div>
        <div class="field">
            <label>@L["releases.signature"] <span class="hint">@L["releases.signature.hint"]</span></label>
            <input @bind="uploadSignature" placeholder="@L["releases.signaturePlaceholder"]" />
        </div>
        <div class="field">
            <label>@L["releases.file"]</label>
            <div class="dropzone">
                <div class="dropzone-icon">⬆</div>
                <div>@L["releases.dropHint"]</div>
                @if (selectedFile is not null)
                {
                    <div style="margin-top:8px;font-size:13px;color:var(--text);">
                        @selectedFile.Name (@FormatSize(selectedFile.Size))
                    </div>
                }
                <InputFile OnChange="FileSelected" />
            </div>
        </div>
        @if (uploadError is not null) { <div class="error">@uploadError</div> }
        @if (uploading) { <div class="info">@L["releases.uploading"]</div> }
        <div class="form-actions">
            <button class="btn-primary" @onclick="UploadArtifact"
                    disabled="@(selectedFile is null || uploading)">
                @L["common.upload"]
            </button>
        </div>
    </div>
    </AuthorizeView>

    @if (release.Artifacts.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>@L["releases.col.platform"]</th>
                    <th>@L["releases.col.arch"]</th>
                    <th>@L["releases.col.file"]</th>
                    <th>@L["releases.col.size"]</th>
                    <th>SHA-256</th>
                    <th>@L["releases.col.signature"]</th>
                    <th>@L["releases.col.downloads"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in release.Artifacts.OrderBy(a => a.Platform))
                {
                    <tr>
                        <td>@a.Platform</td>
                        <td>@a.Architecture</td>
                        <td>@a.FileName</td>
                        <td>@FormatSize(a.FileSizeBytes)</td>
                        <td><code class="hash" title="@a.Sha256">@a.Sha256[..12]…</code></td>
                        <td>@(a.Signature is not null ? "✓" : "—")</td>
                        <td>@a.DownloadCount</td>
                        <td>
                            <AuthorizeView Roles="Admin,Manager">
                                <button class="btn-danger-sm" @onclick="() => DeleteArtifact(a.Id)">
                                    @L["common.delete"]
                                </button>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state"><p>@L["releases.empty"]</p></div>
    }

    @if (confirmDelete)
    {
        <div class="modal-backdrop">
            <div class="modal-card">
                <h2>@L["releases.delete.confirm"] — @release.Version</h2>
                <p>@L["releases.delete.warn"]</p>
                <div class="form-actions">
                    <button class="btn-danger" @onclick="DeleteRelease">@L["common.deleteYes"]</button>
                    <button class="btn-ghost" @onclick="() => confirmDelete = false">@L["common.cancel"]</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid ReleaseId { get; set; }

    private Release? release;
    private IBrowserFile? selectedFile;
    private string uploadPlatform = "windows";
    private string uploadArch = "x64";
    private string? uploadSignature;
    private bool uploading;
    private string? uploadError;
    private bool confirmDelete;
    private bool editingMinFrom;
    private string? minFromInput;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load() => release = await AdminSvc.GetReleaseAsync(ReleaseId);

    private void FileSelected(InputFileChangeEventArgs e) => selectedFile = e.File;

    private async Task UploadArtifact()
    {
        if (selectedFile is null || release is null) return;
        uploading = true;
        uploadError = null;
        try
        {
            const long maxSize = 500L * 1024 * 1024; // 500 MB
            await using var stream = selectedFile.OpenReadStream(maxAllowedSize: maxSize);
            await AdminSvc.AddArtifactAsync(
                release.Id, uploadPlatform, uploadArch,
                stream, selectedFile.Name, uploadSignature);
            selectedFile = null;
            uploadSignature = null;
            await Load();
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
        }
        finally { uploading = false; }
    }

    private async Task Publish()
    {
        if (release is null) return;
        await AdminSvc.PublishReleaseAsync(release.Id);
        await Load();
    }

    private async Task Archive()
    {
        if (release is null) return;
        await AdminSvc.ArchiveReleaseAsync(release.Id);
        await Load();
    }

    private async Task DeleteArtifact(Guid id)
    {
        await AdminSvc.DeleteArtifactAsync(id);
        await Load();
    }

    private void ConfirmDelete() => confirmDelete = true;

    private void StartEditMinFrom()
    {
        minFromInput   = release?.MinFromVersion;
        editingMinFrom = true;
    }

    private async Task SaveMinFrom()
    {
        if (release is null) return;
        await AdminSvc.SetMinFromVersionAsync(release.Id, minFromInput);
        editingMinFrom = false;
        await Load();
    }

    private async Task DeleteRelease()
    {
        if (release is null) return;
        var appSlug = release.App.Slug;
        await AdminSvc.DeleteReleaseAsync(release.Id);
        Nav.NavigateTo($"/apps/{appSlug}");
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024             => $"{bytes} B",
        < 1024 * 1024      => $"{bytes / 1024.0:F1} KB",
        _                  => $"{bytes / (1024.0 * 1024):F1} MB"
    };
}
