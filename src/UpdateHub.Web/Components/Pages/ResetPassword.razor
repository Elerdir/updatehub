@page "/account/reset"
@attribute [AllowAnonymous]
@layout UpdateHub.Web.Components.Layout.EmptyLayout
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["reset.title"] — UpdateHub</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-brand">UpdateHub</div>
        <h2 style="font-size:16px;font-weight:600;margin-bottom:8px;text-align:center;">@L["reset.title"]</h2>

        @if (string.IsNullOrEmpty(Token))
        {
            <div class="error">@L["reset.error.missingToken"]</div>
            <a href="/account/forgot" class="btn-primary btn-block" style="text-align:center;text-decoration:none;display:block;">
                @L["forgot.title"]
            </a>
        }
        else
        {
            <p style="text-align:center;color:var(--muted);margin-bottom:20px;font-size:13px;">
                @L["reset.prompt"]
            </p>
            <form method="post" action="/account/reset">
                <AntiforgeryToken />
                <input type="hidden" name="token" value="@Token" />
                @if (ErrorCode == "missing")   { <div class="error">@L["changepw.error.missing"]</div> }
                else if (ErrorCode == "mismatch") { <div class="error">@L["changepw.error.mismatch"]</div> }
                else if (ErrorCode == "invalid")  { <div class="error">@L["reset.error.invalid"]</div> }

                <div class="field">
                    <label for="new">@L["changepw.new"]</label>
                    <input id="new" type="password" name="new" autocomplete="new-password" minlength="8" required autofocus />
                </div>
                <div class="field">
                    <label for="confirm">@L["changepw.confirm"]</label>
                    <input id="confirm" type="password" name="confirm" autocomplete="new-password" minlength="8" required />
                </div>
                <button type="submit" class="btn-primary btn-block">@L["reset.submit"]</button>
            </form>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }
}
