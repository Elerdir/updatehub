@page "/login/totp"
@attribute [AllowAnonymous]
@layout UpdateHub.Web.Components.Layout.EmptyLayout
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["login.totp.title"] — UpdateHub</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-brand">UpdateHub</div>
        <p style="text-align:center;color:var(--muted);margin-bottom:20px;font-size:14px;">
            @L["login.totp.prompt"]
        </p>
        <form method="post" action="/account/totp">
            <AntiforgeryToken />
            @if (HasError)
            {
                <div class="error">@L["login.totp.invalid"]</div>
            }
            <div class="field">
                <label for="code">@L["login.totp.code"]</label>
                <input id="code" type="text" name="code"
                       inputmode="numeric" autocomplete="one-time-code"
                       maxlength="6" placeholder="000000"
                       style="letter-spacing:8px;font-size:20px;text-align:center;"
                       required autofocus />
            </div>
            <button type="submit" class="btn-primary btn-block">@L["login.totp.submit"]</button>
        </form>
        <div style="margin-top:16px;text-align:center;">
            <a href="/login" style="font-size:13px;color:var(--muted);">← @L["login.title"]</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    private bool HasError => ErrorCode == "1";
}
