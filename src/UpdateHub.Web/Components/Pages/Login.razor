@page "/login"
@attribute [AllowAnonymous]
@layout UpdateHub.Web.Components.Layout.EmptyLayout
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["login.title"] — UpdateHub</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-brand">UpdateHub</div>
        <form method="post" action="/account/login">
            <AntiforgeryToken />
            @if (IsBlocked)
            {
                <div class="error">@L["login.blocked"]</div>
            }
            else if (HasError)
            {
                <div class="error">@L["login.invalid"]</div>
            }
            <div class="field">
                <label for="username">@L["login.username"]</label>
                <input id="username" type="text" name="username" autocomplete="username" required autofocus />
            </div>
            <div class="field">
                <label for="password">@L["login.password"]</label>
                <input id="password" type="password" name="password" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn-primary btn-block">@L["login.submit"]</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorCode { get; set; }

    private bool HasError    => ErrorCode == "1";
    private bool IsBlocked   => ErrorCode == "blocked";
}
