@page "/login"
@attribute [AllowAnonymous]
@layout UpdateHub.Web.Components.Layout.EmptyLayout

<PageTitle>Login — UpdateHub</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-brand">UpdateHub</div>
        <form method="post" action="/account/login">
            <AntiforgeryToken />
            @if (HasError)
            {
                <div class="error">Invalid username or password.</div>
            }
            <div class="field">
                <label for="username">Username</label>
                <input id="username" type="text" name="username" autocomplete="username" required autofocus />
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input id="password" type="password" name="password" autocomplete="current-password" required />
            </div>
            <button type="submit" class="btn-primary btn-block">Sign in</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private int? ErrorCode { get; set; }

    private bool HasError => ErrorCode == 1;
}
