@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AdminService AdminSvc
@inject AuditService AuditSvc
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["dashboard.title"] — UpdateHub</PageTitle>

<div class="page-header">
    <h1>@L["dashboard.title"]</h1>
</div>

<div class="stats">
    <div class="stat-card">
        <span class="stat-value">@appCount</span>
        <span class="stat-label">@L["dashboard.stat.applications"]</span>
    </div>
    <div class="stat-card">
        <span class="stat-value">@publishedCount</span>
        <span class="stat-label">@L["dashboard.stat.published"]</span>
    </div>
    <div class="stat-card">
        <span class="stat-value">@totalDownloads</span>
        <span class="stat-label">@L["dashboard.stat.downloads"]</span>
    </div>
</div>

@if (apps is not null && apps.Count > 0)
{
    <div class="section-header">
        <h2>@L["dashboard.applications"]</h2>
        <a href="/apps" class="btn-sm btn-outline">@L["dashboard.viewAll"]</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>@L["dashboard.col.name"]</th>
                <th>@L["dashboard.col.slug"]</th>
                <th>@L["dashboard.col.latest"]</th>
                <th>@L["dashboard.col.releases"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in apps)
            {
                var latest = app.Releases
                    .Where(r => r.Status == ReleaseStatus.Published && r.Channel == ReleaseChannel.Stable)
                    .OrderByDescending(r => r.PublishedAt)
                    .FirstOrDefault();
                <tr>
                    <td><strong>@app.Name</strong></td>
                    <td><code>@app.Slug</code></td>
                    <td>@(latest?.Version ?? "—")</td>
                    <td>@app.Releases.Count</td>
                    <td><a href="/apps/@app.Slug">@L["dashboard.manage"]</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else if (apps is not null)
{
    <div class="empty-state">
        <p>@L["dashboard.empty"]</p>
        <a href="/apps" class="btn-primary">@L["dashboard.empty.cta"]</a>
    </div>
}

@if (recentActivity is not null && recentActivity.Count > 0)
{
    <div class="section-header">
        <h2>@L["dashboard.recent"]</h2>
        <a href="/audit" class="btn-sm btn-outline">@L["dashboard.viewAll"]</a>
    </div>
    <table class="table">
        <tbody>
            @foreach (var e in recentActivity)
            {
                <tr>
                    <td style="white-space:nowrap;color:var(--muted);font-size:12px;width:120px;">
                        @FormatDate(e.OccurredAt)
                    </td>
                    <td><code>@e.Action</code></td>
                    <td>@e.Actor</td>
                    <td style="color:var(--muted);font-size:12px;">@(e.Details ?? "")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<App>? apps;
    private int appCount;
    private int publishedCount;
    private long totalDownloads;
    private List<UpdateHub.Domain.Entities.AuditEntry>? recentActivity;

    protected override async Task OnInitializedAsync()
    {
        apps = await AdminSvc.GetAppsAsync();
        (appCount, publishedCount, totalDownloads) = await AdminSvc.GetStatsAsync();
        recentActivity = await AuditSvc.GetRecentAsync(15);
    }

    private static string FormatDate(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1)  return "just now";
        if (diff.TotalHours   < 1)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays    < 1)  return $"{(int)diff.TotalHours}h ago";
        return dt.ToString("yyyy-MM-dd HH:mm");
    }
}
