@page "/apps"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AdminService AdminSvc
@inject NavigationManager Nav
@inject UpdateHub.Web.Localization.Translator L

<PageTitle>@L["page.apps"] — UpdateHub</PageTitle>

<div class="page-header">
    <h1>@L["page.apps"]</h1>
    <AuthorizeView Roles="Admin,Manager">
        <button class="btn-primary" @onclick="() => showForm = true">+ @L["apps.new"]</button>
    </AuthorizeView>
</div>

@if (showForm)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <h2>@L["apps.new"]</h2>
            <div class="field">
                <label>@L["apps.slug"] <span class="hint">@L["apps.slug.hint"]</span></label>
                <input @bind="newSlug" placeholder="my-app" />
            </div>
            <div class="field">
                <label>@L["common.name"]</label>
                <input @bind="newName" placeholder="My Application" />
            </div>
            <div class="field">
                <label>@L["apps.descriptionOptional"]</label>
                <textarea @bind="newDescription" rows="2"></textarea>
            </div>
            @if (formError is not null)
            {
                <div class="error">@formError</div>
            }
            <div class="form-actions">
                <button class="btn-primary" @onclick="CreateApp">@L["common.create"]</button>
                <button class="btn-ghost" @onclick="CancelForm">@L["common.cancel"]</button>
            </div>
        </div>
    </div>
}

@if (apps is null)
{
    <p class="loading">@L["common.loading"]</p>
}
else if (apps.Count == 0)
{
    <div class="empty-state">
        <p>@L["apps.empty"]</p>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@L["common.name"]</th>
                <th>@L["apps.slug"]</th>
                <th>@L["apps.releases"]</th>
                <th>@L["apps.col.created"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in apps)
            {
                <tr>
                    <td><strong>@app.Name</strong>@if (!string.IsNullOrEmpty(app.Description)) {<br /><small class="muted">@app.Description</small>}</td>
                    <td><code>@app.Slug</code></td>
                    <td>@app.Releases.Count</td>
                    <td>@app.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td><a href="/apps/@app.Slug">@L["releases.manage"]</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    private List<App>? apps;
    private bool showForm;
    private string newSlug = "";
    private string newName = "";
    private string? newDescription;
    private string? formError;

    protected override async Task OnParametersSetAsync()
    {
        var all = await AdminSvc.GetAppsAsync();
        apps = string.IsNullOrWhiteSpace(Query)
            ? all
            : all.Where(a =>
                a.Name.Contains(Query, StringComparison.OrdinalIgnoreCase) ||
                a.Slug.Contains(Query, StringComparison.OrdinalIgnoreCase) ||
                (a.Description?.Contains(Query, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();
    }

    private async Task CreateApp()
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(newSlug)) { formError = L["apps.err.slugRequired"]; return; }
        if (string.IsNullOrWhiteSpace(newName))  { formError = L["apps.err.nameRequired"]; return; }

        try
        {
            var app = await AdminSvc.CreateAppAsync(newSlug, newName, newDescription);
            Nav.NavigateTo($"/apps/{app.Slug}");
        }
        catch (Exception ex)
        {
            formError = ex.Message.Contains("UNIQUE") ? L["apps.err.slugExists"] : ex.Message;
        }
    }

    private void CancelForm()
    {
        showForm = false;
        newSlug = newName = "";
        newDescription = formError = null;
    }
}
