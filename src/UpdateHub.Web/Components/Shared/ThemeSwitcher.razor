@rendermode InteractiveServer
@inject IJSRuntime JS
@inject UpdateHub.Web.Localization.Translator L

<select class="pref-select" @bind="_current" @bind:after="OnChange">
    <option value="auto">🖥️ &nbsp;@L["nav.theme.auto"]</option>
    <option value="light">☀️ &nbsp;@L["nav.theme.light"]</option>
    <option value="dark">🌙 &nbsp;@L["nav.theme.dark"]</option>
</select>

@code {
    private string _current = "auto";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _current = await JS.InvokeAsync<string>("updateHubTheme.get");
        StateHasChanged();
    }

    private async Task OnChange() =>
        await JS.InvokeVoidAsync("updateHubTheme.set", _current);
}
