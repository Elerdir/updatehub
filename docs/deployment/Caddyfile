updates.example.com {
    # Caddy handles TLS automatically via Let's Encrypt

    # Large artifact uploads (installers can be 500 MB+)
    request_body {
        max_size 600MB
    }

    reverse_proxy localhost:8080 {
        # Required for Blazor Server WebSocket (SignalR)
        transport http {
            keepalive 30s
        }

        header_up Host              {host}
        header_up X-Real-IP         {remote_host}
        header_up X-Forwarded-For   {remote_host}
        header_up X-Forwarded-Proto {scheme}

        flush_interval -1
    }
}
