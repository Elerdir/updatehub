<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UpdateHub.Client</RootNamespace>
    <AssemblyName>UpdateHub.Client</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet metadata -->
    <PackageId>UpdateHub.Client</PackageId>
    <Version>1.0.0</Version>
    <Description>Client library for checking application updates via UpdateHub.</Description>
    <Authors>Elerdir</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Elerdir/updatehub</RepositoryUrl>
  </PropertyGroup>

</Project>
